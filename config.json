{
  "name": "astock-monitor",
  "version": "0.1.0",
  "comment": "萤火计划·A股量化监控系统。config.json 是唯一配置正本;路径相对仓库根目录解析。",
  "paths": {
    "data_dir": "data",
    "db": "data/monitor.db",
    "lake_raw": "data/lake/raw",
    "lake_norm": "data/lake/normalized",
    "state_dir": "data/state",
    "cnequity_lake": "data/cnequity-lake"
  },
  "collect": {
    "min_interval_seconds": 1.0,
    "backoff_initial_seconds": 300,
    "backoff_max_seconds": 2400,
    "cooldown_file": "data/state/rate_limit_cooldown.json",
    "calendar_cache": "data/state/trading_calendar.json"
  },
  "limits": {
    "board_pct": {
      "main": 0.1,
      "chinext": 0.2,
      "chinext_before_2020_08_24": 0.1,
      "star": 0.2,
      "bse": 0.3,
      "st_main": 0.05
    }
  },
  "backtest": {
    "broker_profile": "cn_stock_t1_low_fee",
    "comment": "AKQuant 试点;trading_calendar 必传(PoC-4 撮合级定案)",
    "cost_round_trip": 0.002,
    "cost_comment": "回合成本=佣金万2.5×2+印花税0.05%卖出+过户费+滑点;记分牌扣成本口径(METHODS §1)"
  },
  "triggers": {
    "erp_low_pct": 0.05,
    "breadth_bear": 0.4,
    "margin_greed_high": 0.9,
    "vol_pct_high": 0.9,
    "erp_window": 2500,
    "state_file": "data/state/triggers_state.json",
    "comment": "2027 watch 触发面板:跨越才推送,持续触发不重复;并行会话可对齐 T1-T7 语义"
  },
  "circuit_breaker": {
    "state_file": "data/state/circuit_breaker.json",
    "events_file": "data/state/circuit_breaker_events.jsonl",
    "comment": "P6 回撤熔断(利弗莫尔 10% 规则机器化,DSR 中性):-10% 单笔离场 / -15% 组合降半 / -25% 清仓+冷却(重启需人工过审)"
  }
}
