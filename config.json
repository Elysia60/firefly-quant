{
  "name": "astock-monitor",
  "version": "0.1.0",
  "comment": "萤火计划·A股量化监控系统。config.json 是唯一配置正本;路径相对仓库根目录解析。",
  "paths": {
    "data_dir": "data",
    "db": "data/monitor.db",
    "lake_raw": "data/lake/raw",
    "lake_norm": "data/lake/normalized",
    "state_dir": "data/state",
    "cnequity_lake": "C:/Users/14676/WorkBuddy/2026-11-12-08-47-41/astock_poc/cnequity_poc/data/cnequity-demo"
  },
  "collect": {
    "min_interval_seconds": 1.0,
    "backoff_initial_seconds": 300,
    "backoff_max_seconds": 2400,
    "cooldown_file": "data/state/rate_limit_cooldown.json",
    "calendar_cache": "data/state/trading_calendar.json"
